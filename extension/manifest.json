{
  "manifest_version": 3,
  "name": "THE LODOWN",
  "version": "1.0.0",
  "description": "Resist corporate media. Amplify local news.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "https://duckduckgo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
