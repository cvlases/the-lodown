{
  "manifest_version": 3,
  "name": "THE LODOWN",
  "version": "2.0.0",
  "description": "Resist corporate media. Amplify local news.",
  "permissions": ["activeTab","storage","tabs","scripting"],
  "host_permissions": ["https://html.duckduckgo.com/*","https://duckduckgo.com/*","https://zssxkynyehqgfcrfaopc.supabase.co/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "background": {"service_worker": "scripts/background.js"},
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
